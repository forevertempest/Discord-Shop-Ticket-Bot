# Discord Bot Token (from Discord Developer Portal -> Bot)
TOKEN=your_discord_bot_token_here

# Target Discord Server (Guild) ID
GUILD_ID=000000000000000000

# Comma-separated Discord User IDs of managers (full access to /shop panel and /shop stats)
MANAGER_USER_IDS=000000000000000000,111111111111111111

# Comma-separated Discord Role IDs of sellers/designers (receive orders in DM, can accept/complete/decline and view /shop stats)
SELLER_ROLE_IDS=000000000000000000

# Optional: Category IDs for active and archived tickets.
# If left empty, the bot will find or create categories by name ("дизайн-заказы" and "архив-дизайн-заказов").
ACTIVE_ORDERS_CATEGORY_ID=
ARCHIVE_ORDERS_CATEGORY_ID=

# Optional: Link to the server channel where customers can leave a review after order completion
REVIEWS_CHANNEL_URL=
